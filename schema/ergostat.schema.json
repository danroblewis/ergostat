{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danroblewis/ergostat/schema/ergostat.schema.json",
  "title": "ergostat model",
  "description": "An ergostat.yaml file (or a file it includes). See docs/SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "#/$defs/name"
    },
    "include": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "keep": {
      "$ref": "#/$defs/duration"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "systems": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/system"
      }
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/item_kind"
      }
    },
    "parameters": {
      "type": "object",
      "description": "The numbers equations name (SPEC §7b)",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "auxiliaries": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/auxiliary"
      }
    },
    "variables": {
      "type": "object",
      "deprecated": true,
      "description": "The old name of auxiliaries: (still read, with a finding)",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/auxiliary"
      }
    },
    "stocks": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stock"
      }
    },
    "flows": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/flow"
      }
    },
    "goals": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/goal"
      }
    },
    "blocks": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/block"
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "duration": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(s|m|h|d)$"
        }
      ]
    },
    "setpoint": {
      "type": "string",
      "pattern": "^\\s*(<=|>=|==|<|>)\\s*-?[0-9]+(\\.[0-9]+)?\\s*$"
    },
    "ref": {
      "type": "string",
      "description": "kind.name or kind.name.port, e.g. stock.inbox, goal.inbox-short.error, block.decide.urgent, flow.processed",
      "pattern": "^((stock|flow|auxiliary|variable|goal|block)\\.)?[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)?$"
    },
    "refs": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ref"
          },
          "minProperties": 1
        }
      ]
    },
    "schedule": {
      "type": "object",
      "properties": {
        "every": {
          "$ref": "#/$defs/duration"
        },
        "cron": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "every",
          "cron"
        ]
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/name"
            }
          }
        },
        "manual": {
          "const": true
        },
        "every": {
          "$ref": "#/$defs/duration"
        },
        "cron": {
          "type": "string"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "parse": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "items": {
          "$ref": "#/$defs/name"
        },
        "state": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          ]
        },
        "measure": {
          "enum": [
            "count",
            "oldest"
          ]
        },
        "entering": {
          "$ref": "#/$defs/name"
        },
        "leaving": {
          "$ref": "#/$defs/name"
        },
        "over": {
          "$ref": "#/$defs/duration"
        },
        "averages": {
          "$ref": "#/$defs/duration",
          "description": "On a flow's run, query or manual sensor: its reading is the average rate over this window before it"
        },
        "where": {
          "type": "object"
        },
        "changes": {
          "enum": [
            "rises",
            "falls",
            "net"
          ],
          "description": "On a flow: its rate from its stock's own successive readings"
        }
      },
      "oneOf": [
        {
          "required": [
            "run"
          ]
        },
        {
          "required": [
            "query"
          ]
        },
        {
          "required": [
            "manual"
          ]
        },
        {
          "required": [
            "items"
          ]
        },
        {
          "required": [
            "changes"
          ]
        }
      ],
      "not": {
        "required": [
          "every",
          "cron"
        ]
      }
    },
    "sensors": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sensor"
      }
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        },
        "initial": {
          "type": "number"
        },
        "cumulative": {
          "type": "boolean",
          "description": "A running total that by its nature never drains (spent so far): no outflow is missing (SPEC section 5)"
        },
        "system": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "sensors": {
          "$ref": "#/$defs/sensors"
        },
        "sensor": {
          "$ref": "#/$defs/sensor"
        }
      },
      "not": {
        "required": [
          "sensors",
          "sensor"
        ]
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/name"
        },
        "to": {
          "$ref": "#/$defs/name"
        },
        "unit": {
          "type": "string"
        },
        "rate": {
          "type": "number"
        },
        "sensors": {
          "$ref": "#/$defs/sensors"
        },
        "sensor": {
          "$ref": "#/$defs/sensor"
        },
        "system": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "driven-by": {
          "$ref": "#/$defs/driven_by"
        },
        "two-way": {
          "type": "boolean",
          "description": "It may run either way (a biflow): a block may move it by a negative amount"
        },
        "equation": {
          "$ref": "#/$defs/equation"
        }
      },
      "anyOf": [
        {
          "required": [
            "from"
          ]
        },
        {
          "required": [
            "to"
          ]
        }
      ],
      "not": {
        "required": [
          "sensors",
          "sensor"
        ]
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold"
      ],
      "properties": {
        "stock": {
          "$ref": "#/$defs/name"
        },
        "flow": {
          "$ref": "#/$defs/name"
        },
        "hold": {
          "$ref": "#/$defs/setpoint"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "critical": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "variable": {
          "$ref": "#/$defs/name",
          "deprecated": true,
          "description": "The old name of auxiliary:"
        },
        "auxiliary": {
          "$ref": "#/$defs/name"
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gain"
          ],
          "description": "The loop's process, from what its controller moves to what the goal holds: first order with dead time, or an integrator (SPEC §8, §12c)",
          "properties": {
            "gain": {
              "type": "number"
            },
            "time-constant": {
              "$ref": "#/$defs/duration"
            },
            "dead-time": {
              "anyOf": [
                {
                  "$ref": "#/$defs/duration"
                },
                {
                  "const": 0
                }
              ]
            },
            "integrating": {
              "type": "boolean"
            },
            "identified": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "stock"
          ]
        },
        {
          "required": [
            "flow"
          ]
        },
        {
          "required": [
            "auxiliary"
          ]
        },
        {
          "required": [
            "variable"
          ]
        }
      ]
    },
    "builtinTypes": {
      "enum": [
        "onoff",
        "compare",
        "proportional",
        "limit",
        "delay",
        "schedule",
        "lookup",
        "select",
        "expr",
        "timer",
        "counter",
        "alarm"
      ]
    },
    "machineTypes": {
      "enum": [
        "program",
        "ai",
        "person",
        "external"
      ]
    },
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/builtinTypes"
            },
            {
              "$ref": "#/$defs/machineTypes"
            }
          ]
        },
        "in": {
          "$ref": "#/$defs/refs"
        },
        "out": {
          "$ref": "#/$defs/refs"
        },
        "role": {
          "enum": [
            "controller",
            "actuator",
            "logic"
          ]
        },
        "system": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/name"
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "ask": {
          "type": "string",
          "minLength": 1
        },
        "parse": {
          "type": "string"
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "every": {
          "$ref": "#/$defs/duration"
        },
        "cron": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "auto",
            "advise"
          ]
        },
        "goal": {
          "$ref": "#/$defs/ref"
        },
        "until": {
          "$ref": "#/$defs/setpoint"
        },
        "min-on": {
          "$ref": "#/$defs/duration"
        },
        "min-off": {
          "$ref": "#/$defs/duration"
        },
        "above": {
          "type": "number"
        },
        "below": {
          "type": "number"
        },
        "back-below": {
          "type": "number"
        },
        "back-above": {
          "type": "number"
        },
        "gain": {
          "type": "number",
          "description": "A proportional block's gain; on a machine block, its law's gain (passed in its params)"
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "delay": {
          "$ref": "#/$defs/duration"
        },
        "after": {
          "$ref": "#/$defs/duration"
        },
        "for": {
          "$ref": "#/$defs/duration"
        },
        "reset": {
          "$ref": "#/$defs/duration"
        },
        "table": {
          "type": [
            "object",
            "array"
          ]
        },
        "pick": {
          "enum": [
            "min",
            "max",
            "first"
          ]
        },
        "expr": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "integral-time": {
          "$ref": "#/$defs/duration",
          "description": "A machine block's integral time, when its law is PI (passed in its params)"
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "every",
          "cron"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "program"
              }
            }
          },
          "then": {
            "required": [
              "run"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai"
              }
            }
          },
          "then": {
            "required": [
              "prompt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "person"
              }
            }
          },
          "then": {
            "required": [
              "ask"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "external"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "run"
                  ]
                },
                {
                  "required": [
                    "prompt"
                  ]
                },
                {
                  "required": [
                    "ask"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "$ref": "#/$defs/builtinTypes"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "agent"
                  ]
                },
                {
                  "required": [
                    "run"
                  ]
                },
                {
                  "required": [
                    "prompt"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "onoff"
              }
            }
          },
          "then": {
            "required": [
              "goal"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "proportional"
              }
            }
          },
          "then": {
            "required": [
              "goal",
              "gain"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "compare"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "above"
                ]
              },
              {
                "required": [
                  "below"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "expr"
              }
            }
          },
          "then": {
            "required": [
              "expr",
              "in"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "schedule",
                  "lookup"
                ]
              }
            }
          },
          "then": {
            "required": [
              "table"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "pick",
              "in"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "timer"
              }
            }
          },
          "then": {
            "required": [
              "after"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "ai"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "model"
              ]
            }
          }
        }
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "person",
            "ai",
            "narrow-ai",
            "decision",
            "program",
            "rule"
          ]
        },
        "external": {
          "type": "boolean"
        },
        "at-once": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string"
        },
        "cost": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "prometheus",
            "command"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "prometheus"
          }
        }
      },
      "then": {
        "required": [
          "url"
        ]
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "within": {
          "$ref": "#/$defs/name"
        },
        "show": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "description": "The measures its box shows: stock, flow or auxiliary references"
        }
      }
    },
    "item_kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[^/].*/"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "on": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/name"
          }
        },
        "show": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "system": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "formats": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "image",
              "markdown",
              "code",
              "text",
              "json",
              "claude-session"
            ]
          }
        }
      }
    },
    "auxiliary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "sensor": {
          "$ref": "#/$defs/sensor"
        },
        "sensors": {
          "$ref": "#/$defs/sensors"
        },
        "driven-by": {
          "$ref": "#/$defs/driven_by"
        },
        "exogenous": {
          "type": "boolean",
          "description": "An input from outside the model: nothing in it drives it"
        },
        "equation": {
          "$ref": "#/$defs/equation"
        }
      },
      "description": "A quantity without memory: determined at each moment by others (SPEC section 7a)"
    },
    "driven_by": {
      "description": "What it follows: flow., stock. or auxiliary. references, each optionally signed (+ rises with it, - falls; unsigned: not known); an entry may be written out as {cause, instant, description}: instant says the dependence is immediate (SPEC section 7)",
      "oneOf": [
        {
          "$ref": "#/$defs/link"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      ]
    },
    "signed_ref": {
      "type": "string",
      "pattern": "^[+-]?(flow|stock|auxiliary|variable)\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)?$"
    },
    "link": {
      "oneOf": [
        {
          "$ref": "#/$defs/signed_ref"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cause"
          ],
          "properties": {
            "cause": {
              "$ref": "#/$defs/signed_ref"
            },
            "instant": {
