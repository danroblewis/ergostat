{"id": "renew-cert", "event": "ready", "title": "Renew the web certificate", "where": "bastion-1", "requester": "the web team", "due": "2026-12-01", "instructions": [{"do": "Go to the certificates folder", "run": "cd /etc/ssl/web", "check": "ls shows web.pem"}, {"do": "Renew it", "run": "sudo renew-cert web", "check": "openssl x509 -enddate -noout -in web.pem shows next year"}, {"do": "Reload the web server", "run": "sudo systemctl reload web", "check": "systemctl is-active web says active"}]}
{"id": "rotate-logs", "event": "ready", "title": "Rotate the audit logs", "where": "bastion-1", "requester": "compliance", "due": "2026-11-28", "instructions": [{"do": "Force a rotation", "run": "sudo logrotate -f /etc/logrotate.d/audit", "check": "ls /var/log/audit shows a new .1 file"}]}
{"id": "reset-switch", "event": "ready", "title": "Reset the lab switch's port 12", "where": "lab-vpn", "requester": "the test team", "instructions": [{"do": "Connect to the lab VPN", "run": "vpn up lab", "check": "ping -c1 lab-switch answers"}, {"do": "Bounce the port", "run": "ssh lab-switch 'port 12 reset'", "check": "ssh lab-switch 'port 12 status' says up"}]}
{"id": "request-access", "event": "ready", "title": "Ask for access to the build host", "where": "anywhere", "requester": "me", "instructions": ["Open an access request for build-host, saying why", "Note its number here"]}
{"id": "clean-cache", "event": "waiting", "title": "Clean the build cache", "where": "build-host", "requester": "the build team", "waits_on": "todo/request-access", "instructions": [{"do": "See how big it is", "run": "du -sh /var/cache/build", "check": "it prints a size"}, {"do": "Remove what is older than a week", "run": "find /var/cache/build -mtime +7 -delete", "check": "du -sh shows less"}]}
{"id": "update-runbook", "event": "added", "title": "Update the on-call runbook", "requester": "the on-call rota"}
