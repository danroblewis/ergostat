#!/usr/bin/env bash
# The ticket factory, set up from scratch (README.md):
#
#   ./setup               check the tools and the sign-ins, download and start Prometheus and the exporter,
#                         clone (or refresh) the sample repository, create the project's state, start ergostat,
#                         and print what to open
#   ./setup --no-run      all of that but starting ergostat
#   ./setup --teardown    stop what it started (ergostat, the exporter, Prometheus); downloads stay
#
# Settings: factory.conf (copied from factory.conf.example the first time), each overridable as TF_<KEY>.
set -euo pipefail
cd "$(dirname "$0")"
HERE=$(pwd)
say() { printf '%s\n' "$*"; }
die() { printf 'setup: %s\n' "$*" >&2; exit 1; }
conf() { (cd bin && python3 -c 'import sys, tf; print(tf.conf(sys.argv[1]))' "$1"); }

if [ ! -f factory.conf ]; then
    cp factory.conf.example factory.conf
    say "wrote factory.conf from factory.conf.example: edit it for your Jira, repository and AI"
fi
SCRATCH=$(cd bin && python3 -c 'import tf; print(tf.SCRATCH)')
PIDS="$SCRATCH/pids"; LOGS="$SCRATCH/logs"
mkdir -p "$PIDS" "$LOGS"
read -r -a ERGOSTAT <<< "$(cd bin && python3 -c 'import shlex, tf; print(shlex.join(tf.ergostat()))')"

stop() {   # stop: NAME
    local f="$PIDS/$1.pid"
    if [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null; then
        kill "$(cat "$f")" && say "stopped $1 ($(cat "$f"))"
    fi
    rm -f "$f"
}

if [ "${1:-}" = "--teardown" ]; then
    "${ERGOSTAT[@]}" run --stop 2>/dev/null || true
    stop exporter
    stop prometheus
    rm -f local/prometheus.yaml
    say "torn down. Kept: $SCRATCH (Prometheus, the clone, the workspaces) and the record (ergostat reset --yes clears it)."
    exit 0
fi

# --- the tools and the sign-ins --------------------------------------------------------------------
for tool in uv gh git python3; do
    command -v "$tool" >/dev/null || die "$tool is not installed"
done
[ "$(conf AI)" != claude ] || command -v claude >/dev/null || die "AI=claude, and claude (Claude Code) is not installed"
command -v claude >/dev/null && say "claude: $(claude --version 2>/dev/null | head -1)"
"${ERGOSTAT[@]}" --version >/dev/null 2>&1 || die "ergostat does not run: ${ERGOSTAT[*]}"
say "ergostat: ${ERGOSTAT[*]}"
TOKEN=$(conf JIRA_TOKEN_FILE); TOKEN="${TOKEN/#\~/$HOME}"
[ -s "$TOKEN" ] || die "no Jira token in $TOKEN (JIRA_TOKEN_FILE): an API token (Cloud) or personal access token (Data Center)"
say "jira: signed in as $(cd bin && python3 jira.py whoami | tr -d '"')"
(cd bin && python3 jira.py check | tr -d '"' | sed 's/^/jira: /') || die "the Jira project does not have the statuses factory.conf names"
gh auth status >/dev/null 2>&1 || die "gh is not signed in: gh auth login"
REPO=$(conf GITHUB_REPO)
gh repo view "$REPO" --json name >/dev/null || die "gh cannot see $REPO"
say "github: $(gh api user --jq .login) can see $REPO"

# --- ports ---------------------------------------------------------------------------------------------
PROM_PORT=$(conf PROM_PORT); EXPORTER_PORT=$(conf EXPORTER_PORT); WEB_PORT=$(conf WEB_PORT)
for p in "$PROM_PORT" "$EXPORTER_PORT" "$WEB_PORT"; do
    case "$p" in 9090|8790) die "port $p is not ours to take: choose another in factory.conf";; esac
done
busy() { python3 -c 'import socket, sys; s = socket.socket(); sys.exit(s.connect_ex(("127.0.0.1", int(sys.argv[1]))) != 0)' "$1"; }

# --- Prometheus ----------------------------------------------------------------------------------------
VERSION=$(conf PROM_VERSION)
case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) PLAT=darwin-arm64 ;; Darwin-x86_64) PLAT=darwin-amd64 ;;
    Linux-x86_64) PLAT=linux-amd64 ;; Linux-aarch64) PLAT=linux-arm64 ;;
    *) die "no Prometheus build for $(uname -s)-$(uname -m)" ;;
esac
PROMDIR="$SCRATCH/prometheus/prometheus-$VERSION.$PLAT"
if [ ! -x "$PROMDIR/prometheus" ]; then
    mkdir -p "$SCRATCH/prometheus/download"
    BASE="https://github.com/prometheus/prometheus/releases/download/v$VERSION"
    TAR="prometheus-$VERSION.$PLAT.tar.gz"
    say "downloading Prometheus $VERSION ($PLAT)"
    curl -fsSL -o "$SCRATCH/prometheus/download/$TAR" "$BASE/$TAR"
    curl -fsSL -o "$SCRATCH/prometheus/download/sha256sums.txt" "$BASE/sha256sums.txt"
    (cd "$SCRATCH/prometheus/download" && grep " $TAR\$" sha256sums.txt | shasum -a 256 -c - >/dev/null) \
        || die "the download's checksum does not match"
    tar -xzf "$SCRATCH/prometheus/download/$TAR" -C "$SCRATCH/prometheus"
fi
cat > "$SCRATCH/prometheus/prometheus.yml" <<EOF
# written by ./setup: scrape the ticket factory's exporter
global:
  scrape_interval: 15s
scrape_configs:
  - job_name: ticket-factory
    static_configs:
      - targets: ["127.0.0.1:$EXPORTER_PORT"]
EOF
if [ -f "$PIDS/prometheus.pid" ] && kill -0 "$(cat "$PIDS/prometheus.pid")" 2>/dev/null; then
    say "prometheus: running already"
else
    busy "$PROM_PORT" && die "port $PROM_PORT (PROM_PORT) is taken"
    nohup "$PROMDIR/prometheus" --config.file="$SCRATCH/prometheus/prometheus.yml" \
        --storage.tsdb.path="$SCRATCH/prometheus/data" --web.listen-address="127.0.0.1:$PROM_PORT" \
        >"$LOGS/prometheus.log" 2>&1 </dev/null &
    echo $! > "$PIDS/prometheus.pid"
    for _ in $(seq 1 30); do curl -fs "http://127.0.0.1:$PROM_PORT/-/ready" >/dev/null 2>&1 && break; sleep 0.5; done
    curl -fs "http://127.0.0.1:$PROM_PORT/-/ready" >/dev/null || die "Prometheus did not start: $LOGS/prometheus.log"
    say "prometheus: http://127.0.0.1:$PROM_PORT (pid $(cat "$PIDS/prometheus.pid"))"
fi
if [ -f "$PIDS/exporter.pid" ] && kill -0 "$(cat "$PIDS/exporter.pid")" 2>/dev/null; then
    say "exporter: running already"
else
    busy "$EXPORTER_PORT" && die "port $EXPORTER_PORT (EXPORTER_PORT) is taken"
    (cd bin && exec nohup python3 exporter.py >"$LOGS/exporter.log" 2>&1 </dev/null) &
    echo $! > "$PIDS/exporter.pid"
    say "exporter: http://127.0.0.1:$EXPORTER_PORT/metrics (pid $(cat "$PIDS/exporter.pid"))"
fi
sed "s/@PROM_PORT@/$PROM_PORT/" local/prometheus.yaml.in > local/prometheus.yaml

# --- the sample repository -----------------------------------------------------------------------------
say "repository: $(cd bin && python3 workspace.py refresh "$REPO")"

# --- the project's state, and ergostat -----------------------------------------------------------------
"${ERGOSTAT[@]}" check | head -3
if [ "${1:-}" != "--no-run" ]; then
    busy "$WEB_PORT" && ! "${ERGOSTAT[@]}" --json 2>/dev/null | grep -q '"running": true' && die "port $WEB_PORT (WEB_PORT) is taken"
    "${ERGOSTAT[@]}" run --port "$WEB_PORT" | grep -E "^(running|web)" || true
fi

cat <<EOF

The ticket factory is set up ($(conf AI) doing the work; gates in gates.conf, gates.local.conf).
  the page          http://127.0.0.1:$WEB_PORT      (Items: the tickets, actions, the daily summary and the OKR)
  Prometheus        http://127.0.0.1:$PROM_PORT/graph?g0.expr=tf_tickets
  a test issue      bin/demo_issues.py create        (labelled $(conf JIRA_LABEL) in $(conf JIRA_PROJECT); at most 3)
  approvals         bin/act.py list, bin/act.py approve ID (or --all)
  the tickets       bin/tickets.py list
  clean up          bin/demo_issues.py cleanup       (closes the demo's pull requests, moves its issues to Done)
  stop it all       ./setup --teardown
EOF
